<Window x:Class="ICY.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ICY Overlay"
        Width="256"
        Height="256"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        IsTabStop="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True">
    <!--
        Plain top-level window. DWM composites it like any other HWND.
        No DirectX / OpenGL / Vulkan hooks. No pixel readback.
    -->
    <Canvas x:Name="Stage"
            Width="256"
            Height="256"
            IsHitTestVisible="False"
            Background="Transparent" />
</Window>
