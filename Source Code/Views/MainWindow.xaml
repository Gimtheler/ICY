<Window x:Class="ICY.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ICY.Views"
        Title="ICY"
        Icon="pack://application:,,,/Assets/icy.ico"
        Width="1040"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="#E8F1F8"
        Opacity="0">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource BgBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Width="16" Height="16" Source="pack://application:,,,/Assets/icy.png" />
                <TextBlock Text="ICY"
                           Margin="8,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="#E8F1F8"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding VersionLabel}"
                           Margin="8,0,0,0"
                           Foreground="#8BA3B5"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="46" Height="36"
                        Content="—"
                        Style="{StaticResource CaptionButton}"
                        Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Width="46" Height="36"
                        Content="☐"
                        Style="{StaticResource CaptionButton}"
                        Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Width="46" Height="36"
                        Content="✕"
                        Style="{StaticResource CaptionButton}"
                        Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,18,22,8" Orientation="Horizontal">
                        <Image Width="32" Height="32" Source="pack://application:,,,/Assets/icy.png" />
                        <TextBlock Text="ICY"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#E8F1F8"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Margin="12,16,12,8">
                        <Button Content="Display" Command="{Binding GoDisplayCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisplayPage}" Value="True">
                                            <Setter Property="Background" Value="#182838" />
                                            <Setter Property="Foreground" Value="#E8F1F8" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Colour" Margin="0,4,0,0" Command="{Binding GoColorCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsColorPage}" Value="True">
                                            <Setter Property="Background" Value="#182838" />
                                            <Setter Property="Foreground" Value="#E8F1F8" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Overlay" Margin="0,4,0,0" Command="{Binding GoOverlayCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverlayPage}" Value="True">
                                            <Setter Property="Background" Value="#182838" />
                                            <Setter Property="Foreground" Value="#E8F1F8" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Zoom" Margin="0,4,0,0" Command="{Binding GoZoomCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsZoomPage}" Value="True">
                                            <Setter Property="Background" Value="#182838" />
                                            <Setter Property="Foreground" Value="#E8F1F8" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Presets" Margin="0,4,0,0" Command="{Binding GoPresetsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPresetsPage}" Value="True">
                                            <Setter Property="Background" Value="#182838" />
                                            <Setter Property="Foreground" Value="#E8F1F8" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Settings" Margin="0,4,0,0" Command="{Binding GoSettingsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                            <Setter Property="Background" Value="#182838" />
                                            <Setter Property="Foreground" Value="#E8F1F8" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="26,18,26,18">
                <views:DisplayPage Visibility="{Binding Page, Converter={StaticResource EnumVis}, ConverterParameter=Display}" />
                <views:ColorPage Visibility="{Binding Page, Converter={StaticResource EnumVis}, ConverterParameter=Color}" />
                <views:OverlayPage Visibility="{Binding Page, Converter={StaticResource EnumVis}, ConverterParameter=Overlay}" />
                <views:ZoomPage Visibility="{Binding Page, Converter={StaticResource EnumVis}, ConverterParameter=Zoom}" />
                <views:PresetsPage Visibility="{Binding Page, Converter={StaticResource EnumVis}, ConverterParameter=Presets}" />
                <views:SettingsPage Visibility="{Binding Page, Converter={StaticResource EnumVis}, ConverterParameter=Settings}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
