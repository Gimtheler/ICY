<UserControl x:Class="ICY.Views.ZoomPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ICY.Models"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <CheckBox DockPanel.Dock="Right"
                          Content="Enabled"
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Foreground="#E8F1F8"
                          IsChecked="{Binding Zoom.Enabled}" />
                <TextBlock Style="{StaticResource TitleText}" Text="Zoom" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Target display" FontWeight="SemiBold" Foreground="#E8F1F8" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Monitors}"
                              SelectedItem="{Binding SelectedZoomMonitor}"
                              DisplayMemberPath="DisplayLabel" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Zoom" FontWeight="SemiBold" Foreground="#E8F1F8" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                   Text="{Binding Zoom.Factor, StringFormat={}{0:0.0}×}" />
                    </DockPanel>
                    <Slider Margin="0,8,0,18" Minimum="1.5" Maximum="8"
                            Value="{Binding Zoom.Factor}" />

                    <DockPanel>
                        <TextBlock Text="Size" FontWeight="SemiBold" Foreground="#E8F1F8" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                   Text="{Binding Zoom.Size, StringFormat=0}" />
                    </DockPanel>
                    <Slider Margin="0,8,0,0" Minimum="80" Maximum="520"
                            Value="{Binding Zoom.Size}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Outline" FontWeight="SemiBold" Foreground="#E8F1F8" Margin="0,0,0,8" />
                        <ComboBox SelectedValue="{Binding Zoom.Outline}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="None" Tag="{x:Static models:ZoomOutline.None}" />
                            <ComboBoxItem Content="White ring" Tag="{x:Static models:ZoomOutline.White}" />
                            <ComboBoxItem Content="Black ring" Tag="{x:Static models:ZoomOutline.Black}" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <TextBlock Text="Thickness" FontWeight="SemiBold" Foreground="#E8F1F8" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                       Text="{Binding Zoom.OutlineThickness, StringFormat=0}" />
                        </DockPanel>
                        <Slider Margin="0,8,0,0" Minimum="1" Maximum="16"
                                Value="{Binding Zoom.OutlineThickness}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Graphics quality" FontWeight="SemiBold" Foreground="#E8F1F8" Margin="0,0,0,8" />
                    <ComboBox SelectedValue="{Binding Zoom.Quality}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Ultra quality" Tag="{x:Static models:ZoomQuality.UltraQuality}" />
                        <ComboBoxItem Content="Quality" Tag="{x:Static models:ZoomQuality.Quality}" />
                        <ComboBoxItem Content="Balanced" Tag="{x:Static models:ZoomQuality.Balanced}" />
                        <ComboBoxItem Content="Performance" Tag="{x:Static models:ZoomQuality.Performance}" />
                        <ComboBoxItem Content="Ultra performance" Tag="{x:Static models:ZoomQuality.UltraPerformance}" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Hotkey" FontWeight="SemiBold" Foreground="#E8F1F8" Margin="0,0,0,8" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right"
                                  Width="110"
                                  ItemsSource="{Binding HotkeyModes}"
                                  SelectedItem="{Binding Zoom.HotkeyMode}" />
                        <Button Content="{Binding CaptureZoomHotkeyLabel}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CaptureZoomHotkeyCommand}" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Clear"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClearZoomHotkeyCommand}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#8BA3B5"
                                   Text="{Binding Zoom.HotkeyLabel, StringFormat=Key: {0}}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
