<Window x:Class="ICY.Views.ConfirmDisplayChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keep this display mode?"
        Width="440"
        Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B1220"
        Foreground="#E8F1F8"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Keep this desktop mode?"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="14"
                       Foreground="#7EC8E3" />
            <TextBlock x:Name="CountdownText"
                       Grid.Row="2"
                       Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       Foreground="#8BA3B5"
                       Text="Keep this mode or revert." />
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Revert"
                        Style="{StaticResource GhostButton}"
                        Width="110"
                        Click="Revert_Click" />
                <Button Content="Keep"
                        Style="{StaticResource PrimaryButton}"
                        Width="110"
                        Margin="10,0,0,0"
                        Click="Keep_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
