<UserControl x:Class="ICY.Views.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ICY.Views"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Reset look"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ResetOverlayCommand}" />
                    <CheckBox Margin="10,0,0,0"
                              Content="Enabled"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"
                              Foreground="#E8F1F8"
                              IsChecked="{Binding Overlay.Enabled}" />
                </StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="Overlay" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Style" FontWeight="SemiBold" Foreground="#E8F1F8" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding OverlayStyles}" SelectedItem="{Binding Overlay.Style}" />
                        <Button Margin="0,10,0,0"
                                Content="Load custom image"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding BrowseCrosshairCommand}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#8BA3B5"
                                   Text="{Binding Overlay.CustomImagePath, TargetNullValue=No image}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Position" FontWeight="SemiBold" Foreground="#E8F1F8" VerticalAlignment="Center" />
                            <TextBox Width="88"
                                     HorizontalAlignment="Right"
                                     TextAlignment="Center"
                                     Text="{Binding Overlay.PositionText, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <CheckBox Content="Fine (1px)"
                                  Margin="0,0,0,8"
                                  Foreground="#E8F1F8"
                                  IsChecked="{Binding FineNudge}" />
                        <Grid HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1"
                                    Content="Up"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding NudgeUpCommand}" />
                            <Button Grid.Row="1"
                                    Content="Left"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding NudgeLeftCommand}" />
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Content="Right"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding NudgeRightCommand}" />
                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    Content="Down"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding NudgeDownCommand}" />
                        </Grid>
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="X" FontWeight="SemiBold" Foreground="#E8F1F8" Width="16" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                       Text="{Binding Overlay.OffsetX, StringFormat=0}" />
                        </DockPanel>
                        <Slider Margin="0,6,0,0" Minimum="-200" Maximum="200"
                                Value="{Binding Overlay.OffsetX}" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Y" FontWeight="SemiBold" Foreground="#E8F1F8" Width="16" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                       Text="{Binding Overlay.OffsetY, StringFormat=0}" />
                        </DockPanel>
                        <Slider Margin="0,6,0,0" Minimum="-200" Maximum="200"
                                Value="{Binding Overlay.OffsetY}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Overlay.SavedPositions}"
                                      SelectedItem="{Binding SelectedSavedPosition}"
                                      DisplayMemberPath="Label" />
                            <Button Grid.Column="2"
                                    Content="&#xE74D;"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#F07178"
                                    Command="{Binding DeleteSavedPositionCommand}" />
                            <Button Grid.Column="4"
                                    Content="Save position"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveOverlayPositionCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Colour" FontWeight="SemiBold" Foreground="#E8F1F8" Margin="0,0,0,10" />
                    <views:ColorPicker Height="160" SelectedColor="{Binding Overlay.Color, Mode=TwoWay}" />
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Hex" VerticalAlignment="Center" Width="40" Foreground="#8BA3B5" />
                        <TextBox Text="{Binding Overlay.ColorHex, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Hotkey" FontWeight="SemiBold" Foreground="#E8F1F8" Margin="0,0,0,8" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right"
                                  Width="110"
                                  ItemsSource="{Binding HotkeyModes}"
                                  SelectedItem="{Binding Overlay.HotkeyMode}" />
                        <Button Content="{Binding CaptureHotkeyLabel}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CaptureHotkeyCommand}" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Clear"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClearHotkeyCommand}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#8BA3B5"
                                   Text="{Binding Overlay.HotkeyLabel, StringFormat=Key: {0}}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock Text="Size" FontWeight="SemiBold" Foreground="#E8F1F8" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                       Text="{Binding Overlay.Size, StringFormat=0}" />
                        </DockPanel>
                        <Slider Margin="0,8,0,0" Minimum="4" Maximum="80" Value="{Binding Overlay.Size}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock Text="Thickness" FontWeight="SemiBold" Foreground="#E8F1F8" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                       Text="{Binding Overlay.Thickness, StringFormat=0.0}" />
                        </DockPanel>
                        <Slider Margin="0,8,0,0" Minimum="1" Maximum="8" Value="{Binding Overlay.Thickness}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock Text="Gap" FontWeight="SemiBold" Foreground="#E8F1F8" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                       Text="{Binding Overlay.Gap, StringFormat=0}" />
                        </DockPanel>
                        <Slider Margin="0,8,0,0" Minimum="0" Maximum="32" Value="{Binding Overlay.Gap}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock Text="Opacity" FontWeight="SemiBold" Foreground="#E8F1F8" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                       Text="{Binding Overlay.Opacity, StringFormat=0.00}" />
                        </DockPanel>
                        <Slider Margin="0,8,0,0" Minimum="0.15" Maximum="1" Value="{Binding Overlay.Opacity}" />
                    </StackPanel>

                    <CheckBox Grid.Row="2"
                              Margin="0,0,0,16"
                              Content="Center dot"
                              Foreground="#E8F1F8"
                              IsChecked="{Binding Overlay.DotCenter}" />
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
                        <DockPanel>
                            <TextBlock Text="Dot size" FontWeight="SemiBold" Foreground="#E8F1F8" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#7EC8E3"
                                       Text="{Binding Overlay.DotSize, StringFormat=0}" />
                        </DockPanel>
                        <Slider Margin="0,8,0,0" Minimum="1" Maximum="24"
                                Value="{Binding Overlay.DotSize}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
