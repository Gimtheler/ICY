<UserControl x:Class="ICY.Views.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleText}" Text="Presets" Margin="0,0,0,16" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Column="2"
                                Content="&#xE74D;"
                                Style="{StaticResource IconButton}"
                                Foreground="#F07178"
                                Command="{Binding DeletePresetCommand}" />
                        <Button Grid.Column="4"
                                Content="Save look"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveLookCommand}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Export" Style="{StaticResource GhostButton}" Command="{Binding ExportPresetCommand}" />
                        <Button Grid.Column="2" Content="Import" Style="{StaticResource GhostButton}" Command="{Binding ImportPresetCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
