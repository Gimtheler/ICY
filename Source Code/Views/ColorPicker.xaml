<UserControl x:Class="ICY.Views.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="168">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <Border x:Name="SvHost"
                CornerRadius="8"
                ClipToBounds="True"
                Cursor="Cross"
                MouseLeftButtonDown="Sv_MouseDown"
                MouseMove="Sv_MouseMove"
                MouseLeftButtonUp="Sv_MouseUp">
            <Grid>
                <Rectangle x:Name="HueBase" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse x:Name="SvThumb"
                         Width="12"
                         Height="12"
                         Stroke="White"
                         StrokeThickness="2"
                         IsHitTestVisible="False"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top" />
            </Grid>
        </Border>
        <Border Grid.Column="2"
                CornerRadius="6"
                ClipToBounds="True"
                Cursor="Hand"
                MouseLeftButtonDown="Hue_MouseDown"
                MouseMove="Hue_MouseMove"
                MouseLeftButtonUp="Hue_MouseUp">
            <Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.17" />
                            <GradientStop Color="#FF00FF00" Offset="0.33" />
                            <GradientStop Color="#FF00FFFF" Offset="0.50" />
                            <GradientStop Color="#FF0000FF" Offset="0.67" />
                            <GradientStop Color="#FFFF00FF" Offset="0.83" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Border x:Name="HueThumb"
                        Height="4"
                        BorderBrush="White"
                        BorderThickness="1"
                        Background="#66FFFFFF"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
        <Border Grid.Column="4"
                Width="48"
                Height="48"
                CornerRadius="8"
                VerticalAlignment="Top"
                BorderBrush="#24344C"
                BorderThickness="1"
                x:Name="Preview" />
    </Grid>
</UserControl>
